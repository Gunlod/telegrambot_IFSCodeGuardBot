[Unit]
Description=IFSCodeGuardBot Telegram group guard
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ifscodeguard
Group=ifscodeguard
WorkingDirectory=/opt/ifscodeguard
ExecStart=/opt/ifscodeguard/.venv/bin/python -m ifscodeguard --config /opt/ifscodeguard/config.yaml
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ifscodeguard/logs

[Install]
WantedBy=multi-user.target
